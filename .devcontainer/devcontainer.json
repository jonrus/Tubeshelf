{
  "name": "Tubeshelf",
  "image": "docker.io/oven/bun:1",
  "remoteUser": "bun",
  // Dev-only recovery password, applied to the default user on every boot. Insecure by
  // design (fixed, checked into the repo) — never use this as a real deployment credential.
  "containerEnv": {
    "AUTH_RECOVERY_PASSWORD": "dev-password-change-me"
  },
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "biomejs.biome",
        "bradlc.vscode-tailwindcss",
        "eamodio.gitlens"
      ],
      "settings": {
        "editor.defaultFormatter": "biomejs.biome",
        "editor.formatOnSave": true,
        "[typescript]": { "editor.defaultFormatter": "biomejs.biome" },
        "[typescriptreact]": { "editor.defaultFormatter": "biomejs.biome" }
      }
    }
  },
  "postCreateCommand": "bun install && bun run css:build",
  "forwardPorts": [3000],
  "portsAttributes": { "3000": { "label": "Tubeshelf web" } }
}
