{
  "name": "tubeshelf",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n server,css \"bun run dev:server\" \"bun run css:watch\"",
    "dev:server": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "css:build": "tailwindcss -i ./src/styles/input.css -o ./public/css/tailwind.css --minify",
    "css:watch": "tailwindcss -i ./src/styles/input.css -o ./public/css/tailwind.css --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "^1.3.14",
    "concurrently": "^10.0.3",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.31"
  },
  "trustedDependencies": [
    "@parcel/watcher"
  ]
}
