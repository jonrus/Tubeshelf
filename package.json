{
  "name": "tubeshelf",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "concurrently -k -n server,css \"bun run dev:server\" \"bun run css:watch\"",
    "dev:server": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "css:build": "tailwindcss -i ./src/styles/input.css -o ./public/css/tailwind.css --minify",
    "css:watch": "tailwindcss -i ./src/styles/input.css -o ./public/css/tailwind.css --watch",
    "postinstall": "test -f node_modules/htmx.org/dist/htmx.min.js && mkdir -p public/js && cp node_modules/htmx.org/dist/htmx.min.js public/js/htmx.min.js || true",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "fallow": "fallow",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/cli": "^4.3.3",
    "bun-types": "^1.4.4",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "fallow": "^3.34.1",
    "htmx.org": "2.0.11",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13"
  },
  "trustedDependencies": [
    "@parcel/watcher"
  ]
}
